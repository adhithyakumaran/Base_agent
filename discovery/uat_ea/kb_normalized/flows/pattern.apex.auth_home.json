    "type": "flow_pattern",
    "title": "apex_auth_to_home",
    "summary": "Login with CSP-safe typing, land on home landmark, capture session from friendly URL.",
    "details": {
      "steps": [
        {"action": "goto_login", "notes": "browser-like UA"},
        {"action": "type_credentials", "notes": "prefer type(delay) over fill when CSP blocks"},
        {"action": "submit"},
        {"action": "assert_home_landmark", "fail_fast": true},
        {"action": "capture_session_query"}
      ],
      "anti_stuck": ["navigation_timeout_ms=45000", "no_retry_for_wrong_password"],
      "references": ["docs/architecture/APEX_APPLICATION_FLOWS.md"]
    }
  }
