# Copy to .env — never commit real secrets
GROQ_API_KEY=gsk_your_key_here
LLM_ENABLED=true
LLM_PROVIDER=groq
LLM_MODEL_FAST=groq/qwen/qwen3.6-27b
LLM_MODEL_REASONING=groq/openai/gpt-oss-120b
QA_RUNNER=playwright
QA_DISCOVERY_ROOT=data/discovery-kb
QA_AUTOMATION_DIR=apps/automation

# P10.1 security (development defaults are permissive on loopback only)
SCOUT_ENV=development
SCOUT_ALLOW_INSECURE_LOCAL=true
SCOUT_API_TOKEN=
SCOUT_INTERNAL_API_TOKEN=
SCOUT_ALLOWED_ORIGIN=http://127.0.0.1:43123
SCOUT_AGENT_BIND_HOST=127.0.0.1
SCOUT_AUTO_BROWSER_SESSION=true

# Production example (fail closed — set both tokens):
# SCOUT_ENV=production
# SCOUT_ALLOW_INSECURE_LOCAL=false
# SCOUT_API_TOKEN=change-me-console-bff
# SCOUT_INTERNAL_API_TOKEN=change-me-warm-server
