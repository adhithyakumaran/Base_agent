# Copy to automation/config/.env — never commit real credentials

EA_BASE_URL=https://dev-ea.titanrts.com/ords/r/tjdcom/ea
EA_LOGIN_URL=login
EA_HOME_URL=home

# Logical test accounts — use vault/CI secrets in production pipelines
EA_USER_USERNAME=
EA_USER_PASSWORD=
EA_ADMIN_USERNAME=
EA_ADMIN_PASSWORD=

# Approved test data references (14-digit item codes from UAT test catalog)
EA_VALID_ITEM_CODE=
EA_INVALID_ITEM_CODE=
EA_NO_STOCK_ITEM_CODE=

EA_IGNORE_HTTPS_ERRORS=false
EA_HEADLESS=false
# Use installed Chrome — required when UAT WAF blocks headless Chromium (406 Not Acceptable)
EA_USE_SYSTEM_CHROME=true
EA_BROWSER_CHANNEL=chrome
